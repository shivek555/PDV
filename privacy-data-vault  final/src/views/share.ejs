<!DOCTYPE html>
<html lang="en" data-disclosure-token="<%= token %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/x-icon" href="/favicon.ico">
  <title>Selective Disclosure - Privacy Vault</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 20px;
    }

    .container {
      background: white;
      border-radius: 10px;
      box-shadow: 0 10px 40px rgba(0, 0, 0, 0.2);
      max-width: 600px;
      width: 100%;
      padding: 40px;
    }

    .header {
      text-align: center;
      margin-bottom: 30px;
    }

    .header h1 {
      color: #333;
      font-size: 28px;
      margin-bottom: 10px;
    }

    .header p {
      color: #666;
      font-size: 14px;
    }

    .alert {
      padding: 15px;
      border-radius: 8px;
      margin-bottom: 20px;
      display: none;
    }

    .alert.show {
      display: block;
    }

    .alert-error {
      background: #f8d7da;
      color: #721c24;
      border: 1px solid #f5c6cb;
    }

    .alert-success {
      background: #d4edda;
      color: #155724;
      border: 1px solid #c3e6cb;
    }

    .alert-warning {
      background: #fff3cd;
      color: #856404;
      border: 1px solid #ffeeba;
    }

    .disclosure-info {
      background: #f9f9f9;
      padding: 20px;
      border-radius: 8px;
      margin-bottom: 20px;
      border-left: 4px solid #667eea;
    }

    .info-row {
      display: flex;
      justify-content: space-between;
      padding: 10px 0;
      border-bottom: 1px solid #eee;
    }

    .info-row:last-child {
      border-bottom: none;
    }

    .info-label {
      font-weight: 600;
      color: #666;
      font-size: 13px;
      text-transform: uppercase;
    }

    .info-value {
      color: #333;
      font-weight: 500;
    }

    .fields-section {
      margin-bottom: 20px;
    }

    .fields-title {
      font-size: 16px;
      font-weight: 600;
      color: #333;
      margin-bottom: 12px;
    }

    .fields-list {
      display: grid;
      gap: 8px;
    }

    .field-item {
      padding: 12px;
      background: #f9f9f9;
      border-radius: 6px;
      border-left: 3px solid #667eea;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .field-name {
      font-weight: 500;
      color: #333;
    }

    .field-status {
      font-size: 12px;
      color: #999;
      background: white;
      padding: 4px 8px;
      border-radius: 4px;
    }

    .field-status.encrypted {
      color: #667eea;
      background: #f0f4ff;
    }

    .field-status.decrypted {
      color: #27ae60;
      background: #f0fff4;
    }

    .actions {
      display: grid;
      gap: 10px;
      margin-bottom: 20px;
    }

    .btn {
      padding: 12px;
      border: none;
      border-radius: 6px;
      font-size: 14px;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.3s;
      text-decoration: none;
      text-align: center;
    }

    .btn-primary {
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      color: white;
    }

    .btn-primary:hover:not(:disabled) {
      transform: translateY(-2px);
      box-shadow: 0 5px 15px rgba(102, 126, 234, 0.4);
    }

    .btn-secondary {
      background: #f0f0f0;
      color: #333;
    }

    .btn-secondary:hover:not(:disabled) {
      background: #e0e0e0;
    }

    .btn:disabled {
      opacity: 0.6;
      cursor: not-allowed;
      transform: none;
    }

    .verification-section {
      background: #f9f9f9;
      padding: 20px;
      border-radius: 8px;
      margin-bottom: 20px;
    }

    .verification-title {
      font-size: 16px;
      font-weight: 600;
      color: #333;
      margin-bottom: 12px;
    }

    .verification-status {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 10px;
      background: white;
      border-radius: 6px;
    }

    .verification-badge {
      width: 24px;
      height: 24px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: bold;
      color: white;
      font-size: 12px;
    }

    .verified {
      background: #27ae60;
    }

    .not-verified {
      background: #e74c3c;
    }

    .verification-text {
      font-size: 14px;
      color: #333;
    }

    .loading {
      display: none;
      text-align: center;
      padding: 20px;
    }

    .spinner {
      display: inline-block;
      width: 24px;
      height: 24px;
      border: 3px solid #f3f3f3;
      border-top: 3px solid #667eea;
      border-radius: 50%;
      animation: spin 1s linear infinite;
    }

    @keyframes spin {
      0% {
        transform: rotate(0deg);
      }
      100% {
        transform: rotate(360deg);
      }
    }

    .footer {
      text-align: center;
      margin-top: 20px;
      padding-top: 20px;
      border-top: 1px solid #eee;
      color: #999;
      font-size: 12px;
    }

    .footer a {
      color: #667eea;
      text-decoration: none;
    }

    .footer a:hover {
      text-decoration: underline;
    }

    .expiration-warning {
      background: #fff3cd;
      border: 1px solid #ffeeba;
      color: #856404;
      padding: 12px;
      border-radius: 6px;
      margin-bottom: 15px;
      font-size: 13px;
    }

    .expiration-warning.expired {
      background: #f8d7da;
      border-color: #f5c6cb;
      color: #721c24;
    }

    @media (max-width: 768px) {
      .container {
        padding: 20px;
      }

      .header h1 {
        font-size: 22px;
      }

      .info-row {
        flex-direction: column;
        gap: 6px;
      }
    }
  </style>
</head>
<body>
  <div class="container" id="shareRoot"
       data-vault-title="<%= disclosure ? disclosure.vaultTitle : '' %>"
       data-disclosed-fields="<%- disclosure ? JSON.stringify(disclosure.disclosedFields).replace(/"/g,'&quot;') : '[]' %>">
    <div class="header">
      <h1>📋 Selective Disclosure</h1>
      <p>View shared information securely</p>
    </div>

    <% if (error) { %>
      <div class="alert alert-error show"><%= error %></div>
      <button class="btn btn-secondary" style="width:100%;" id="goHomeBtn">← Back to Home</button>
    <% } else if (disclosure) { %>
      <!-- Keep your expiration warning and info sections as-is -->
      <!-- ... disclosure info and fields ... -->

      <div class="actions">
        <button class="btn btn-primary" id="decryptBtn">🔓 Decrypt & View Data</button>
        <button class="btn btn-secondary" id="downloadBtn">💾 Download Proof</button>
      </div>

      <div class="loading" id="loading">
        <div class="spinner"></div>
        <p>Processing...</p>
      </div>

      <div id="decryptedSection" style="display:none; margin-top:20px;">
        <div class="fields-section">
          <div class="fields-title">✓ Decrypted Information</div>
          <div id="decryptedData" style="background:#f9f9f9; padding:15px; border-radius:6px;"></div>
        </div>
        <button class="btn btn-secondary" style="width:100%; margin-top:10px;" id="hideDecryptedBtn">
          Hide Decrypted Data
        </button>
      </div>
    <% } %>

    <div class="footer">
      <p>🛡️ Privacy Vault - Secure Selective Disclosure Platform</p>
      <p>© 2025 All rights reserved. <a href="#">Privacy Policy</a></p>
    </div>
  </div>

  <script src="../../js/share.js" defer></script>
</body>
</html>
